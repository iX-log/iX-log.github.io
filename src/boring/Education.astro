---
import { getCollection } from 'astro:content';
const education = await getCollection('education');
---
<section id="education" aria-labelledby="education-title">
  <div class="wrap">
    <h2 class="section-title" id="education-title">Education</h2>
    <div class="timeline">
      {education.map(({ data: e }) => (
        <article class="entry">
          <p class="when">{e.start} – {e.end}</p>
          <div>
            <h3>{e.school}</h3>
            <p class="sub">{e.degree}</p>
            {e.thesis && (
              <p style="margin-top:12px">
                <span class="label">Thesis</span><br />
                <strong>“{e.thesis.title}”</strong>: {e.thesis.summary}
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
