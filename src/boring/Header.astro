---
import { getEntry } from 'astro:content';
const profile = (await getEntry('profile', 'main'))!.data;
const roleParts = profile.role.split(' · ');
---
<header class="site-header">
  <div class="wrap">
    <h1>{profile.name}</h1>
    <p class="role">
      {roleParts.map((part, i) => (
        <><span>{part}{i < roleParts.length - 1 && <i aria-hidden="true">&nbsp;·</i>}</span>{' '}</>
      ))}
    </p>
    <nav class="nav-links" aria-label="Primary">
      <a href="#writing">Writing</a>
      <a href={profile.links.github} rel="me noopener">GitHub</a>
      <a href={profile.links.linkedin} rel="me noopener">LinkedIn</a>
    </nav>
  </div>
</header>
