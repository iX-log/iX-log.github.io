---
import { getCollection } from 'astro:content';
import Todo from '../components/Todo.astro';
const talks = (await getCollection('talks')).sort((a, b) => a.data.order - b.data.order);
---
<section id="talks" aria-labelledby="talks-title">
  <div class="wrap">
    <h2 class="section-title" id="talks-title">Talks</h2>
    <ul class="list">
      {talks.map(({ data: t }) => (
        <li>
          {t.title
            ? <>
                <span>
                  {t.video ? <a href={t.video} rel="noopener">{t.title} ↗</a> : t.title}
                </span>
                <span class="meta">{t.event} · {t.year}</span>
              </>
            : <Todo items={t.todos} />}
        </li>
      ))}
    </ul>
  </div>
</section>
